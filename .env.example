# Modelo do .env local. Copie para .env (na raiz do repositório) e troque
# TODOS os valores "troque-me". O .env nunca vai para o git.
#
#   cp .env.example .env
#
# Mudou uma senha depois do primeiro "up"? O init do Postgres só roda com
# volume vazio: veja docs/operacao/postgres-local.md.

# Superusuário do container (usado só pelo init e pelos scripts de operação).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-me

# Dono dos bancos agro_mro / agro_mro_test e do schema public (migrações).
AGRO_OWNER_PASSWORD=troque-me

# Papel da aplicação: só SELECT/INSERT/UPDATE/DELETE, não é dono de nada.
AGRO_APP_PASSWORD=troque-me

# Use senhas só com letras, números, "-" e "_" (vão dentro de URLs de conexão).
# A porta publicada (127.0.0.1:55432) NÃO é lida deste arquivo; para trocar,
# veja docs/operacao/postgres-local.md (variável POSTGRES_PORT no shell).

# --- Backend (FastAPI + Alembic) ---------------------------------------------
# Troque "troque-me" pelas MESMAS senhas acima (AGRO_APP_PASSWORD / AGRO_OWNER_PASSWORD).
# Só postgresql+psycopg:// é aceito. Sem estas variáveis a API/Alembic não sobem.
APP_ENV=dev
# Fuso só de apresentação (o banco e a API gravam em UTC).
APP_DISPLAY_TIMEZONE=America/Cuiaba
# API: papel agro_app (só DML).
DATABASE_URL=postgresql+psycopg://agro_app:troque-me@127.0.0.1:55432/agro_mro
# Alembic: papel agro_owner (dono do schema).
DATABASE_URL_MIGRATIONS=postgresql+psycopg://agro_owner:troque-me@127.0.0.1:55432/agro_mro

# Testes do backend (scripts/test_backend.sh): SEMPRE o banco agro_mro_test.
# Se ficarem vazias/ausentes, o script monta as duas a partir das senhas acima.
TEST_DATABASE_URL=postgresql+psycopg://agro_app:troque-me@127.0.0.1:55432/agro_mro_test
TEST_DATABASE_URL_MIGRATIONS=postgresql+psycopg://agro_owner:troque-me@127.0.0.1:55432/agro_mro_test
