# Modelo do .env local. Copie para .env (na raiz do repositório) e troque
# TODOS os valores "troque-me". O .env nunca vai para o git.
#
#   cp .env.example .env
#
# Mudou uma senha depois do primeiro "up"? O init do Postgres só roda com
# volume vazio: veja docs/operacao/postgres-local.md.

# Superusuário do container (usado só pelo init e pelos scripts de operação).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-me

# Dono dos bancos agro_mro / agro_mro_test e do schema public (migrações).
AGRO_OWNER_PASSWORD=troque-me

# Papel da aplicação: só SELECT/INSERT/UPDATE/DELETE, não é dono de nada.
AGRO_APP_PASSWORD=troque-me

# Use senhas só com letras, números, "-" e "_" (vão dentro de URLs de conexão).
# A porta publicada (127.0.0.1:55432) NÃO é lida deste arquivo; para trocar,
# veja docs/operacao/postgres-local.md (variável POSTGRES_PORT no shell).
