        </mxCell>
        <mxCell id="101" value="06 Aplicação e cenários • §11 / R24–R26" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=13.6;fontColor=#176250;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="804" y="563.0" width="343" height="16.73" as="geometry" />
        </mxCell>
        <mxCell id="102" value="A(x) = q × ceil(max(x,0)/q). q: múltiplo positivo; senão 1 para" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="804" y="584.73" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="103" value="inteiro ou passo declarado fracionável. Sem q, bruto pode existir e" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
