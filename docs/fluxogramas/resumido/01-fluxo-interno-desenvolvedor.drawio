        <mxCell id="42" value="MEMÓRIA DO MOTOR V3 / 01–06 • NC = NÃO CALCULÁVEL • ES = ESTOQUE DE SEGURANÇA • PP = PONTO DE PEDIDO • EM = ESTOQUE MÁXIMO" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.2;fontColor=#176250;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="32" y="330.0" width="1125" height="13.78" as="geometry" />
        </mxCell>
        <mxCell id="43" value="" style="rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#A2B4B3;html=0;" vertex="1" parent="1">
          <mxGeometry x="32" y="353" width="367" height="188" as="geometry" />
        </mxCell>
        <mxCell id="44" value="01 Série e saldos • §4 / R02–R05" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=13.6;fontColor=#176250;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="44" y="363.0" width="343" height="16.73" as="geometry" />
        </mxCell>
        <mxCell id="45" value="n = dias da janela; Dd = OUT no dia (un.); O = ΣDd; I = ΣIN." style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="44" y="384.73" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="46" value="μ = O/n (un./dia); σ = √[Σ(Dd − μ)²/(n − 1)] (un. da série diária);" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="44" y="398.87" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="47" value="n=1 dá σ=0 se a série existe." style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="44" y="413.01" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="48" value="S0 inferido = Sf oficial − I + O; senão, use S0 declarado se" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="44" y="427.15" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="49" value="disponível. Sd = S0 + Σ(IN − OUT) até d; delta = S0 declarado + I" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="44" y="441.29" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="50" value="− O − Sf oficial." style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="44" y="455.43" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="51" value="Giro = 365μ/S̄ se S̄&gt;0; cobertura = Sf oficial/μ se μ&gt;0; valor = Sf" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="44" y="469.57" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="52" value="oficial × custo MD (BRL)." style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="44" y="483.71" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="53" value="Dias sem OUT recebem zero em série qualificada. Sem fonte" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="44" y="497.85" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="54" value="válida, preserve indisponibilidade." style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="44" y="511.99" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="55" value="" style="rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#A2B4B3;html=0;" vertex="1" parent="1">
          <mxGeometry x="412" y="353" width="367" height="188" as="geometry" />
        </mxCell>
        <mxCell id="56" value="02 ABC, PQR e novos • §5 / R06–R08" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=13.6;fontColor=#176250;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="424" y="363.0" width="343" height="16.73" as="geometry" />
        </mxCell>
        <mxCell id="57" value="ABC: wᵢ = μᵢ × custo MD; pᵢ = Σ(j≤i) wⱼ / Σ(coorte) wⱼ; ordenar w" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="424" y="384.73" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="58" value="decrescente. Cortes padrão: A ≤80%; B &gt;80% até 95%; C &gt;95%;" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="424" y="398.87" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="59" value="D se w=0. Coorte incompleta bloqueia ABC." style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="424" y="413.01" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="60" value="PQR: f = 365 × eventos IN ou OUT / n (trans./ano). P ≥12; Q de 3" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="424" y="427.15" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="61" value="a &lt;12; R &gt;0 a &lt;3; S se zero calculável. Entradas em minúsculas." style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="424" y="441.29" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="62" value="N/n precede as classes com idade conhecida de 0 a &lt;180 dias" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="424" y="455.43" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="63" value="(padrão) e sem OUT comprovado até t1. OUT anterior pode" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="424" y="469.57" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="64" value="liberar N/n sem compor a série." style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="424" y="483.71" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="65" value="" style="rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#A2B4B3;html=0;" vertex="1" parent="1">
          <mxGeometry x="792" y="353" width="367" height="188" as="geometry" />
        </mxCell>
        <mxCell id="66" value="03 Serviço, quantil e TMEA • §§6–7" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=13.6;fontColor=#176250;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="804" y="363.0" width="343" height="16.73" as="geometry" />
        </mxCell>
        <mxCell id="67" value="NS manual explícito prevalece. Senão, matriz privada se houver," style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="804" y="384.73" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="68" value="ou V3 padrão; chave PQR OUT + ABC + XYZ efetivo. Chave" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="804" y="398.87" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="69" value="privada ausente dá NC." style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="804" y="413.01" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="70" value="NS = 0 ou 0,50 ≤ NS &lt; 1; Z = inversa de Φ em NS, para NS" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="804" y="427.15" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="71" value="positivo. Política exige fonte diária, n ≥ max(2, LT), NS positivo e" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="804" y="441.29" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="72" value="cenário válido." style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="804" y="455.43" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="73" value="Q(W): ordene somas das m = n − W + 1 janelas de W dias; use" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="804" y="469.57" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="74" value="ordem ceil(NS × m). n&lt;W dá NC." style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="804" y="483.71" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="75" value="TMEA = n/k (dias); k = dias com OUT positivo. Intervalos PQR" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="804" y="497.85" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="76" value="usam n/contagem de eventos." style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="804" y="511.99" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="77" value="" style="rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#A2B4B3;html=0;" vertex="1" parent="1">
          <mxGeometry x="32" y="553" width="367" height="188" as="geometry" />
        </mxCell>
        <mxCell id="78" value="04 Segurança e pedido • §§8–9 / R10–R16" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=13.6;fontColor=#176250;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="44" y="563.0" width="343" height="16.73" as="geometry" />
        </mxCell>
        <mxCell id="79" value="LT = prazo (dias); σLT = desvio do prazo (dias); R = revisão" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="44" y="584.73" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="80" value="(dias). Brutos em unidades de estoque." style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="44" y="598.87" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="81" value="ES Inversa Normal = μ + Zσ." style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="44" y="613.01" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="82" value="ES TMEA = (μ + Zσ) × TMEA / (LT + ZσLT); requer TMEA, σLT" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="44" y="627.15" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="83" value="declarado e denominador &gt;0." style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="44" y="641.29" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="84" value="ES Raiz tradicional = Z√(σ²LT + σLT²μ²); requer σLT. ES Fator" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="44" y="655.43" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="85" value="tradicional = Zσ√LT." style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="44" y="669.57" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="86" value="ES Motor = max(Q(LT) − μLT, 0)." style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="44" y="683.71" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="87" value="PP Tradicional = μLT + ES escolhido; PP Motor = Q(LT). Use ES" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="44" y="697.85" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="88" value="selecionado/aplicado ou manual." style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="44" y="711.99" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="89" value="" style="rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#A2B4B3;html=0;" vertex="1" parent="1">
          <mxGeometry x="412" y="553" width="367" height="188" as="geometry" />
        </mxCell>
        <mxCell id="90" value="05 Máximo • §10 / R17–R23" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=13.6;fontColor=#176250;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="424" y="563.0" width="343" height="16.73" as="geometry" />
        </mxCell>
        <mxCell id="91" value="Na seleção: 01 ES + PP; 02 ES + μ(LT + R + B), B =" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="424" y="584.73" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="92" value="max(Z,0)σLT; 03 Q(LT) + Q(R). Use ES/PP escolhidos e insumos" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="424" y="598.87" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="93" value="de cada método." style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="424" y="613.01" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="94" value="Só comparação, com H = LT + R: 04 μH + ES_H (ES do horizonte" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="424" y="627.15" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="95" value="H com referência); 05 μH + Zσ√H; 06 μH + Z√(Hσ² + μ²σLT²) (σLT" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="424" y="641.29" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="96" value="declarado); 07 menor inteiro s com FPoisson(μH)(s) ≥ NS." style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="424" y="655.43" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="97" value="Poisson exige natureza/saídas inteiras e busca s até 1000; sem" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="424" y="669.57" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="98" value="atingir o alvo, NC. Os métodos 04–07 ficam fora dos cenários e" style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="424" y="683.71" width="343" height="14.14" as="geometry" />
        </mxCell>
        <mxCell id="99" value="da política." style="text;html=0;whiteSpace=none;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#18312F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="424" y="697.85" width="343" height="14.14" as="geometry" />
