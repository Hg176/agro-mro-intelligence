        <mxCell id="title" value="D08.6 | Estados de análise e validação&#10;V02 • 03/11/2026 • Plano E64 / contrato E63&#10;UML de estados simplificada • transições reais P6 • guardas completas nas fichas/contratos" style="rounded=1;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=19;fillColor=#DDF3E9;strokeColor=#819C92;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1">
